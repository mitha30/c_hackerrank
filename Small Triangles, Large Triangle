#include <stdio.h>
#include <stdlib.h>
#include <math.h>

struct triangle
{
	int a;
	int b;
	int c;
};

typedef struct triangle triangle;
void sort_by_area(triangle* tr, int n) {
    /**
    * Sort an array of total_num triangles by their areas from smallest to largest.
    */
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            // Calculate square of area for triangle j
            double p1 = (tr[j].a + tr[j].b + tr[j].c) / 2.0;
            double area_sq1 = p1 * (p1 - tr[j].a) * (p1 - tr[j].b) * (p1 - tr[j].c);

            // Calculate square of area for triangle j + 1
            double p2 = (tr[j + 1].a + tr[j + 1].b + tr[j + 1].c) / 2.0;
            double area_sq2 = p2 * (p2 - tr[j + 1].a) * (p2 - tr[j + 1].b) * (p2 - tr[j + 1].c);

            // Compare and swap if out of order
            if (area_sq1 > area_sq2) {
                triangle temp = tr[j];
                tr[j] = tr[j + 1];
                tr[j + 1] = temp;
            }
        }
    }
}


int main()
{
	int n;
	scanf("%d", &n);
	triangle *tr = malloc(n * sizeof(triangle));
	for (int i = 0; i < n; i++) {
		scanf("%d%d%d", &tr[i].a, &tr[i].b, &tr[i].c);
	}
	sort_by_area(tr, n);
	for (int i = 0; i < n; i++) {
		printf("%d %d %d\n", tr[i].a, tr[i].b, tr[i].c);
	}
	return 0;
}
