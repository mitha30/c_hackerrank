#include <stdio.h>
#include <stdlib.h>

void update(int *a, int *b) {
    // Store original values before making modifications
    int temp_a = *a;
    int temp_b = *b;
    
    // Set a to the sum of both numbers
    *a = temp_a + temp_b;
    
    // Set b to the absolute difference of both numbers
    *b = abs(temp_a - temp_b);
}

int main() {
    int a, b;
    int *pa = &a, *pb = &b;
    
    scanf("%d %d", &a, &b);
    update(pa, pb);
    printf("%d\n%d", a, b);

    return 0;
}
