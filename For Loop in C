#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() {
    int a, b;
    scanf("%d\n%d", &a, &b);
    
    // Array map for numbers from 1 to 9
    char *words[] = {"one", "two", "three", "four", "five", "six", "seven", "eight", "nine"};

    // Loop through the interval [a, b] inclusive
    for (int i = a; i <= b; i++) {
        if (i >= 1 && i <= 9) {
            // Index matches (i - 1) due to 0-based array indexing
            printf("%s\n", words[i - 1]);
        } else if (i > 9 && i % 2 == 0) {
            printf("even\n");
        } else if (i > 9 && i % 2 != 0) {
            printf("odd\n");
        }
    }

    return 0;
}
